
@{
    ViewBag.Title = "Marca";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb bg-transparent p-0 d-flex align-items-center">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Index","Home")" style="color: var(--gem-sapphire); text-decoration: none;">
                <i class="fas fa-chart-pie" style="color: var(--gem-pink-fancy);"></i> Dashboard
            </a>
        </li>
        <li class="breadcrumb-item active" style="color: var(--gem-emerald); font-weight: 600;">
            <i class="fas fa-medal"></i>Marcas
        </li>
    </ol>
</nav>

<div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
    <div class="card-header py-3" style="background: linear-gradient(90deg, #162e55 0%, #1d4d44 100%); color: white;">
        <div class="d-flex justify-content-between align-items-center">
            <span><i class="fas fa-medal" style="color: var(--gem-pink-fancy);"></i> Gestión de Marcas de Lujo</span>
            <button type="button" class="btn btn-lumi" onclick="abrirModal(null)">
                <i class="fas fa-plus-circle me-1"></i> Nueva Marca
            </button>
        </div>
    </div>
    <div class="card-body bg-white">
        <div class="table-responsive">
            <table id="tabla" class="table table-hover align-middle" style="width: 100%; border-collapse: separate !important; border-spacing: 0 8px !important;">
                <thead style="background-color: var(--gem-soft-sapphire); color: var(--gem-sapphire);">
                    <tr>
                        <th class="border-0 ps-3">Descripción</th>
                        <th class="border-0">Estado</th>
                        <th class="border-0 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-0"></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="FormModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 text-white" style="background: var(--gem-sapphire); border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold" id="modalTitulo">
                    <i class="fas fa-certificate me-2" style="color: var(--gem-gold-leaf);"></i> Detalle Marca
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input id="txtid" type="hidden" value="0" />
                <div class="row g-3">
                    <div class="col-sm-12">
                        <label for="txtdescripcion" class="form-label small fw-bold text-muted">Nombre de la Marca</label>
                        <input type="text" class="form-control form-control-modern" id="txtdescripcion" placeholder="Ej: Cartier, Rolex..." autocomplete="off">
                    </div>
                    <div class="col-sm-12">
                        <label for="cboactivo" class="form-label small fw-bold text-muted">Estatus de Disponibilidad</label>
                        <select id="cboactivo" class="form-select form-control-modern">
                            <option value="1">Activo</option>
                            <option value="0">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div id="mensajeError" class="alert alert-danger mt-3 d-none border-0 shadow-sm" style="border-radius: 10px;">
                    <i class="fas fa-exclamation-circle me-2"></i> <span id="errorText">Error al procesar la marca.</span>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light p-3" style="border-radius: 0 0 20px 20px;">
                <button type="button" class="btn btn-outline-secondary px-4 shadow-sm" data-bs-dismiss="modal" style="border-radius: 10px;">Cerrar</button>
                <button type="button" class="btn btn-lumi px-4 shadow-sm" onclick="Guardar()">
                    <i class="fas fa-save me-1"></i> Guardar Marca
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control-modern {
        border-radius: 10px;
        border: 1px solid #e0e7ff;
        padding: 0.6rem 1rem;
        transition: all 0.3s;
    }

        .form-control-modern:focus {
            border-color: var(--gem-pink-fancy);
            box-shadow: 0 0 0 0.25rem rgba(255, 133, 162, 0.15);
        }

    .table-hover tbody tr:hover {
        background-color: #f8faff !important;
        transform: scale(1.005);
        transition: all 0.2s ease;
    }

    .btn-action-edit {
        color: var(--gem-sapphire);
        background: var(--gem-soft-sapphire);
        border: none;
    }

    .btn-action-delete {
        color: var(--gem-ruby);
        background: #fff0f0;
        border: none;
    }
</style>

@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>

    <script>
        var tabladata;
        $(document).ready(function () {
            tabladata = $("#tabla").DataTable({
                responsive: true,
                ordering: false,
                "ajax": {
                    "url": '@Url.Action("ListarMarcas", "Mantenimiento")',
                    "type": "GET"
                },
                "columns": [
                    { "data": "Descripcion" },
                    {
                        "data": "Activo", "render": function (v) {
                            return v ?
                                '<span class="badge px-3 py-2" style="background-color: var(--gem-emerald); border-radius: 8px;">Activo</span>' :
                                '<span class="badge px-3 py-2" style="background-color: #6c757d; border-radius: 8px;">Inactivo</span>';
                        }
                    },
                    {
                        "defaultContent": '<div class="text-center">' +
                            '<button type="button" class="btn btn-action-edit btn-sm btn-editar shadow-sm"><i class="fas fa-pen"></i></button>' +
                            '<button type="button" class="btn btn-action-delete btn-sm ms-2 btn-eliminar shadow-sm"><i class="fas fa-trash"></i></button>' +
                            '</div>',
                        "width": "110px"
                    }
                ],
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.11.3/i18n/es_es.json" }
            });
        });

        function abrirModal(json) {
            $("#txtid").val(0);
            $("#txtdescripcion").val("");
            $("#cboactivo").val(1);
            $("#mensajeError").addClass("d-none");

            if (json != null) {
                $("#modalTitulo").html('<i class="fas fa-edit me-2" style="color: var(--gem-gold-leaf);"></i> Editar Marca');
                $("#txtid").val(json.IdMarca);
                $("#txtdescripcion").val(json.Descripcion);
                $("#cboactivo").val(json.Activo ? 1 : 0);
            } else {
                $("#modalTitulo").html('<i class="fas fa-plus-circle me-2" style="color: var(--gem-gold-leaf);"></i> Nueva Marca');
            }
            $("#FormModal").modal("show");
        }

        $("#tabla tbody").on("click", '.btn-editar', function () {
            var data = tabladata.row($(this).closest("tr")).data();
            abrirModal(data);
        });

        $("#tabla tbody").on("click", '.btn-eliminar', function () {
            var data = tabladata.row($(this).closest("tr")).data();
            Swal.fire({
                title: "¿Eliminar Marca?",
                text: "Desea retirar de la colección: " + data.Descripcion,
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: '#d00000', // Organiza sección
                cancelButtonColor: '#1a3a6d', // Organiza sección
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar"
            }).then((res) => {
                if (res.isConfirmed) {
                    $.post('@Url.Action("EliminarMarca", "Mantenimiento")', { id: data.IdMarca }, function (d) {
                        if (d.resultado) {
                            tabladata.ajax.reload();
                            Swal.fire({ icon: 'success', title: 'Eliminado', text: 'La marca ha sido removida.', timer: 1500, showConfirmButton: false });
                        } else {
                            Swal.fire("Atención", d.mensaje, "error");
                        }
                    });
                }
            });
        });

        function Guardar() {
            var obj = {
                IdMarca: $("#txtid").val(),
                Descripcion: $("#txtdescripcion").val(),
                Activo: $("#cboactivo").val() == 1
            };

            $(".modal-content").LoadingOverlay("show", { imageColor: "#ff85a2" });

            $.ajax({
                url: '@Url.Action("GuardarMarca", "Mantenimiento")',
                type: "POST",
                data: JSON.stringify({ objeto: obj }),
                contentType: "application/json; charset=utf-8",
                success: function (d) {
                    $(".modal-content").LoadingOverlay("hide");
                    if (d.resultado != 0) {
                        tabladata.ajax.reload();
                        $("#FormModal").modal("hide");
                        Swal.fire({ icon: 'success', title: '¡Perfecto!', text: 'Los cambios se guardaron con éxito.', timer: 2000, showConfirmButton: false });
                    }
                    else {
                        $("#mensajeError").text(d.mensaje).removeClass("d-none");
                        Swal.fire("Error", d.mensaje, "error");
                    }
                },
                error: function() {
                    $(".modal-content").LoadingOverlay("hide");
                }
            });
        }
    </script>
}
