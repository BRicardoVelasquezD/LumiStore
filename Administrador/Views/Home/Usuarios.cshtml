
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb bg-transparent p-0 d-flex align-items-center">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Index","Home")" style="color: var(--gem-sapphire); text-decoration: none;">
                <i class="fas fa-chart-pie" style="color: var(--gem-pink-fancy);"></i> Dashboard
            </a>
        </li>
        <li class="breadcrumb-item active" style="color: var(--gem-emerald); font-weight: 600;">
            <i class="fas fa-users-cog me-1"></i> Usuarios
        </li>
    </ol>
</nav>

<div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
    <div class="card-header py-3" style="background: linear-gradient(90deg, #162e55 0%, #1d4d44 100%); color: white;">
        <div class="d-flex justify-content-between align-items-center">
            <span><i class="fas fa-users-cog me-2" style="color: var(--gem-pink-fancy);"></i> Gestión de Usuarios Elite</span>
            <button type="button" class="btn btn-lumi" onclick="abrirModal(null)">
                <i class="fas fa-plus-circle me-1"></i> Registrar Usuario
            </button>
        </div>
    </div>

    <div class="card-body bg-white">
        <div class="table-responsive">
            <table id="tabla" class="table table-hover align-middle" style="width: 100%; border-collapse: separate !important; border-spacing: 0 8px !important;">
                <thead style="background-color: var(--gem-soft-sapphire); color: var(--gem-sapphire);">
                    <tr>
                        <th class="border-0 ps-3">Nombres</th>
                        <th class="border-0">Apellidos</th>
                        <th class="border-0">Correo Electrónico</th>
                        <th class="border-0">Estado</th>
                        <th class="border-0 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-0">
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="FormModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 text-white" style="background: var(--gem-sapphire); border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold" id="modalTitulo">
                    <i class="fas fa-user-edit me-2" style="color: var(--gem-gold-leaf);"></i> Perfil de Usuario
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <input id="txtid" type="hidden" value="0" />

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label for="txtnombres" class="form-label small fw-bold text-muted">Nombres</label>
                        <input type="text" class="form-control form-control-modern" id="txtnombres" autocomplete="off" placeholder="Ej: Elena">
                    </div>
                    <div class="col-sm-6">
                        <label for="txtapellidos" class="form-label small fw-bold text-muted">Apellidos</label>
                        <input type="text" class="form-control form-control-modern" id="txtapellidos" autocomplete="off" placeholder="Ej: Lumière">
                    </div>
                    <div class="col-sm-12">
                        <label for="txtcorreo" class="form-label small fw-bold text-muted">Correo Electrónico Corporativo</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                            <input type="email" class="form-control form-control-modern border-start-0" id="txtcorreo" placeholder="usuario@lumistore.com" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <label for="cboactivo" class="form-label small fw-bold text-muted">Estatus</label>
                        <select id="cboactivo" class="form-select form-control-modern">
                            <option value="1">Activo</option>
                            <option value="0">Inactivo</option>
                        </select>
                    </div>
                </div>

                <div id="mensajeError" class="alert alert-danger mt-3 d-none border-0 shadow-sm" style="border-radius: 10px;">
                    <i class="fas fa-exclamation-circle me-2"></i> <span id="errorText">Hubo un error al procesar.</span>
                </div>
            </div>

            <div class="modal-footer border-0 bg-light p-3" style="border-radius: 0 0 20px 20px;">
                <button type="button" class="btn btn-outline-secondary px-4 shadow-sm" data-bs-dismiss="modal" style="border-radius: 10px;">Cancelar</button>
                <button type="button" class="btn btn-lumi px-4 shadow-sm" onclick="Guardar()">
                    <i class="fas fa-save me-1"></i> Guardar Usuario
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control-modern {
        border-radius: 10px;
        border: 1px solid #e0e7ff;
        padding: 0.6rem 1rem;
        transition: all 0.3s;
    }

        .form-control-modern:focus {
            border-color: var(--gem-pink-fancy);
            box-shadow: 0 0 0 0.25rem rgba(255, 133, 162, 0.15);
        }

    .table-hover tbody tr:hover {
        background-color: #f8faff !important;
        transform: scale(1.005);
        transition: all 0.2s ease;
    }

    .btn-action-edit {
        color: var(--gem-sapphire);
        background: var(--gem-soft-sapphire);
        border: none;
    }

    .btn-action-delete {
        color: var(--gem-ruby);
        background: #fff0f0;
        border: none;
    }
</style>

@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>

    <script>
        var tabladata;
        var filaSeleccionada;

        $(document).ready(function () {
            tabladata = $("#tabla").DataTable({
                responsive: true,
                ordering: false,
                "ajax": {
                    "url": '@Url.Action("ListarUsuarios", "Home")',
                    "type": "GET",
                    "dataType": "json"
                },
                "columns": [
                    { "data": "Nombres" },
                    { "data": "Apellidos" },
                    { "data": "Correo" },
                    {
                        "data": "Activo",
                        "render": function (valor) {
                            if (valor) {
                                return '<span class="badge px-3 py-2" style="background-color: var(--gem-emerald); border-radius: 8px;">Activo</span>';
                            } else {
                                return '<span class="badge px-3 py-2" style="background-color: #6c757d; border-radius: 8px;">Inactivo</span>';
                            }
                        }
                    },
                    {
                        "defaultContent": '<div class="text-center">' +
                            '<button type="button" class="btn btn-action-edit btn-sm btn-editar shadow-sm"><i class="fas fa-pen"></i></button>' +
                            '<button type="button" class="btn btn-action-delete btn-sm ms-2 btn-eliminar shadow-sm"><i class="fas fa-trash"></i></button>' +
                            '</div>',
                        "orderable": false,
                        "searchable": false,
                        "width": "110px"
                    }
                ],
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.11.3/i18n/es_es.json"
                }
            });
        });

        function abrirModal(json) {
            $("#txtid").val(0);
            $("#txtnombres").val("");
            $("#txtapellidos").val("");
            $("#txtcorreo").val("");
            $("#cboactivo").val(1);
            $("#mensajeError").addClass("d-none");

            if (json != null) {
                $("#modalTitulo").html('<i class="fas fa-edit me-2" style="color: var(--gem-gold-leaf);"></i> Editar Usuario');
                $("#txtid").val(json.IdUsuario);
                $("#txtnombres").val(json.Nombres);
                $("#txtapellidos").val(json.Apellidos);
                $("#txtcorreo").val(json.Correo);
                $("#cboactivo").val(json.Activo == true ? 1 : 0);
            } else {
                $("#modalTitulo").html('<i class="fas fa-plus-circle me-2" style="color: var(--gem-gold-leaf);"></i> Nuevo Usuario');
            }
            $("#FormModal").modal("show");
        }

        $("#tabla tbody").on("click", '.btn-editar', function () {
            filaSeleccionada = $(this).closest("tr");
            var data = tabladata.row(filaSeleccionada).data();
            abrirModal(data);
        });

        // ACTUALIZADO CON SWEETALERT2 PARA ELIMINAR
        $("#tabla tbody").on("click", '.btn-eliminar', function () {
            var usuarioSeleccionado = tabladata.row($(this).closest("tr")).data();

            Swal.fire({
                title: '¿Eliminar Usuario?',
                text: "Desea eliminar al usuario: " + usuarioSeleccionado.Correo,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d00000',
                cancelButtonColor: '#1a3a6d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("EliminarUsuario", "Home")',
                        type: "POST",
                        data: JSON.stringify({ id: usuarioSeleccionado.IdUsuario }),
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {
                            if (data.resultado) {
                                tabladata.ajax.reload();
                                Swal.fire('Eliminado', 'El usuario ha sido retirado.', 'success');
                            } else {
                                Swal.fire('Error', data.mensaje, 'error');
                            }
                        }
                    });
                }
            });
        });

        function Guardar() {
            var Usuario = {
                IdUsuario: $("#txtid").val(),
                Nombres: $("#txtnombres").val(),
                Apellidos: $("#txtapellidos").val(),
                Correo: $("#txtcorreo").val(),
                Activo: $("#cboactivo").val() == 1 ? true : false
            };

            $(".modal-body").LoadingOverlay("show");

            $.ajax({
                url: '@Url.Action("GuardarUsuario", "Home")',
                type: "POST",
                data: JSON.stringify({ objeto: Usuario }),
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    $(".modal-body").LoadingOverlay("hide");

                    if (data.resultado != 0 && data.resultado != false) {
                        tabladata.ajax.reload();
                        $("#FormModal").modal("hide");

                        // ALERTA DE ÉXITO PREMIUM
                        Swal.fire({
                            icon: 'success',
                            title: '¡Logrado!',
                            text: 'El usuario se guardó correctamente',
                            timer: 2000,
                            showConfirmButton: false
                        });

                    } else {
                        $("#mensajeError").text(data.mensaje).removeClass("d-none");
                        Swal.fire('Atención', data.mensaje, 'error');
                    }
                },
                error: function () {
                    $(".modal-body").LoadingOverlay("hide");
                    Swal.fire('Error', 'No se pudo procesar la solicitud', 'error');
                }
            });
        }
    </script>
}