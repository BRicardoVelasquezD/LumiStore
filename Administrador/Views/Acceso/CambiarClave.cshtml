@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lumi Store - Seguridad Elite</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --gem-sapphire: #162e55; /* Zafiro */
            --gem-emerald: #1d4d44; /* Esmeralda Dark */
            --gem-ruby: #dc3545; /* Rubí */
            --gem-diamond: #ffffff; /* Diamante */
            --gem-sapphire-soft: #eef2ff; /* Zafiro Soft */
            --gem-emerald-vivid: #10b981; /* Esmeralda Vivo */
            --gem-pink-fancy: #ff85a2; /* Fancy Pink */
        }

        body {
            background: linear-gradient(135deg, var(--gem-sapphire) 0%, var(--gem-emerald) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

            /* Efecto de partículas de luz */
            body::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at 80% 20%, rgba(255, 133, 162, 0.1) 0%, transparent 40%);
                z-index: 0;
            }

        .login-card {
            background: var(--gem-diamond);
            border-radius: 30px;
            border: none;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            position: relative;
            z-index: 1;
        }

        .login-header {
            background: var(--gem-sapphire);
            padding: 40px 30px;
            text-align: center;
            position: relative;
            border-bottom: 4px solid var(--gem-pink-fancy);
        }

        .brand-icon {
            width: 65px;
            height: 65px;
            background: var(--gem-diamond);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            color: var(--gem-sapphire);
            font-size: 1.6rem;
            box-shadow: 0 8px 15px rgba(0,0,0,0.2);
        }

        .login-header h2 {
            color: var(--gem-diamond);
            letter-spacing: 3px;
            font-weight: 800;
            font-size: 1.4rem;
            margin: 0;
            text-transform: uppercase;
        }

        .alert-security {
            color: var(--gem-pink-fancy);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: 10px;
            font-weight: 700;
        }

        .card-body {
            padding: 40px !important;
        }

        /* Inputs Personalizados */
        .form-floating > .form-control {
            border: 2px solid var(--gem-sapphire-soft);
            border-radius: 15px;
            background-color: var(--gem-sapphire-soft);
            transition: all 0.3s ease;
        }

            .form-floating > .form-control:focus {
                background-color: var(--gem-diamond);
                border-color: var(--gem-pink-fancy);
                box-shadow: 0 0 0 4px rgba(255, 133, 162, 0.1);
            }

        /* Botón Guardar - Mix Esmeralda/Zafiro */
        .btn-update {
            background: linear-gradient(45deg, var(--gem-emerald) 0%, var(--gem-emerald-vivid) 100%);
            border: none;
            border-radius: 15px;
            padding: 16px;
            font-weight: 700;
            color: var(--gem-diamond);
            letter-spacing: 1px;
            transition: all 0.3s ease;
            text-transform: uppercase;
        }

            .btn-update:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 20px rgba(16, 185, 129, 0.3);
                filter: brightness(1.1);
                color: var(--gem-diamond);
            }

        .security-text {
            background: #fff0f3;
            color: var(--gem-ruby);
            padding: 10px;
            border-radius: 10px;
            font-size: 0.85rem;
            margin-bottom: 25px;
            border-left: 4px solid var(--gem-ruby);
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5 col-xl-4">
                <div class="login-card">
                    <div class="login-header">
                        <div class="brand-icon">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h2>SEGURIDAD</h2>
                        <p class="alert-security">Actualización Obligatoria</p>
                    </div>

                    <div class="card-body">
                        <div class="security-text text-center">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Por su seguridad, debe reemplazar la clave temporal enviada por correo.
                        </div>

                        <form id="updateForm" action="@Url.Action("CambiarClave", "Acceso")" method="post">
                            <input type="hidden" name="idusuario" value="@TempData["IdUsuario"]" />

                            <div class="form-floating mb-3">
                                <input class="form-control" id="claveactual" type="password" name="claveactual" placeholder="Clave Temporal" required />
                                <label for="claveactual"><i class="fas fa-key me-2"></i>Contraseña Temporal</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input class="form-control" id="nuevaclave" type="password" name="nuevaclave" placeholder="Nueva Clave" required />
                                <label for="nuevaclave"><i class="fas fa-lock me-2"></i>Nueva Contraseña</label>
                            </div>

                            <div class="form-floating mb-4">
                                <input class="form-control" id="confirmarclave" type="password" name="confirmarclave" placeholder="Confirmar" required />
                                <label for="confirmarclave"><i class="fas fa-check-double me-2"></i>Confirmar Contraseña</label>
                            </div>

                            <div class="d-grid">
                                <button class="btn btn-update btn-lg" type="submit">
                                    Actualizar y Entrar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>

    <script>
        $(document).ready(function () {
            // Loading con estilo Elite
            $("#updateForm").submit(function () {
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-shield-alt fa-spin",
                    background: "rgba(22, 46, 85, 0.8)",
                    fontawesomeColor: "#ff85a2"
                });
            });

            // Manejo de errores (Rubí)
            @if (ViewBag.Error != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: '<span style="color:var(--gem-ruby)">Error de Validación</span>',
                    text: '@ViewBag.Error',
                    confirmButtonColor: '#162e55',
                    customClass: { popup: 'rounded-4' }
                });
                </text>
            }
        });
    </script>
</body>
</html>