@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lumi Store - Elite Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            /* Paleta de Gemas Completa */
            --gem-sapphire: #162e55; /* Zafiro */
            --gem-emerald: #1d4d44; /* Esmeralda Dark */
            --gem-ruby: #dc3545; /* Rubí */
            --gem-diamond: #ffffff; /* Diamante */
            --gem-sapphire-soft: #eef2ff; /* Zafiro Soft */
            --gem-emerald-vivid: #10b981; /* Esmeralda Vivo */
            --gem-pink-fancy: #ff85a2; /* Fancy Pink */
        }

        body {
            background: linear-gradient(135deg, var(--gem-sapphire) 0%, var(--gem-emerald) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            position: relative;
        }

            /* Luces de ambiente usando Esmeralda y Zafiro */
            body::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at 15% 15%, rgba(16, 185, 129, 0.15) 0%, transparent 50%), radial-gradient(circle at 85% 85%, rgba(255, 133, 162, 0.1) 0%, transparent 50%);
                z-index: 0;
            }

        .login-card {
            background: var(--gem-diamond);
            border-radius: 30px;
            border: none;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
            overflow: hidden;
            position: relative;
            z-index: 1;
        }

        .login-header {
            background: var(--gem-sapphire);
            padding: 50px 30px;
            text-align: center;
            position: relative;
        }

            /* Detalle decorativo Fancy Pink */
            .login-header::after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 25%;
                width: 50%;
                height: 4px;
                background: var(--gem-pink-fancy);
                border-radius: 10px 10px 0 0;
            }

        .brand-icon {
            width: 70px;
            height: 70px;
            background: var(--gem-diamond);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            color: var(--gem-sapphire);
            font-size: 1.8rem;
            transform: rotate(-10deg);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }

        .login-header h2 {
            color: var(--gem-diamond);
            letter-spacing: 5px;
            font-weight: 800;
            font-size: 1.6rem;
            margin: 0;
        }

        .login-header p {
            color: var(--gem-emerald-vivid);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            margin-top: 8px;
            font-weight: 700;
        }

        .card-body {
            background-color: var(--gem-diamond);
            padding: 45px !important;
        }

        /* Inputs con enfoque Fancy Pink */
        .form-floating > .form-control {
            border: 2px solid var(--gem-sapphire-soft);
            border-radius: 15px;
            background-color: var(--gem-sapphire-soft);
            transition: all 0.3s ease;
        }

            .form-floating > .form-control:focus {
                background-color: var(--gem-diamond);
                border-color: var(--gem-pink-fancy);
                box-shadow: 0 0 0 4px rgba(255, 133, 162, 0.15);
            }

        .form-floating > label {
            color: var(--gem-sapphire);
            font-weight: 500;
        }

        /* Botón de Ingreso - Gradiente Zafiro a Esmeralda */
        .btn-ingresar {
            background: linear-gradient(45deg, var(--gem-sapphire) 0%, var(--gem-emerald) 100%);
            border: none;
            border-radius: 15px;
            padding: 15px;
            font-weight: 700;
            color: var(--gem-diamond);
            letter-spacing: 2px;
            transition: all 0.4s ease;
            text-transform: uppercase;
        }

            .btn-ingresar:hover {
                transform: scale(1.02);
                box-shadow: 0 10px 20px rgba(22, 46, 85, 0.3);
                filter: brightness(1.2);
                color: var(--gem-diamond);
            }

        .forgot-password {
            color: var(--gem-sapphire);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .forgot-password:hover {
                color: var(--gem-ruby); /* Cambio a Rubí al pasar el mouse */
                letter-spacing: 0.5px;
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5 col-xl-4">
                <div class="login-card">
                    <div class="login-header">
                        <div class="brand-icon">
                            <i class="fas fa-gem"></i>
                        </div>
                        <h2>LUMI STORE</h2>
                        <p>Administración</p>
                    </div>

                    <div class="card-body">
                        <form id="loginForm" action="@Url.Action("Index", "Acceso")" method="post">
                            <div class="form-floating mb-4">
                                <input class="form-control" id="correo" type="email" name="correo" placeholder="name@example.com" required />
                                <label for="correo"><i class="fas fa-envelope me-2"></i>Correo Electronico</label>
                            </div>

                            <div class="form-floating mb-4">
                                <input class="form-control" id="clave" type="password" name="clave" placeholder="Password" required />
                                <label for="clave"><i class="fas fa-lock me-2"></i>Contraseña</label>
                            </div>

                            <div class="d-grid gap-3">
                                <button class="btn btn-ingresar btn-lg shadow-sm" type="submit">
                                    Acceder
                                </button>
                                <div class="text-center">
                                    <a class="forgot-password" href="@Url.Action("Reestablecer", "Acceso")">
                                        ¿Olvidó sus credenciales?
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>

    <script>
        $(document).ready(function () {
            // Loading con color Zafiro
            $("#loginForm").submit(function () {
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-gem fa-spin",
                    background: "rgba(22, 46, 85, 0.7)",
                    fontawesomeColor: "#ff85a2" // Icono de carga en Fancy Pink
                });
            });

            // Errores en Rubí
            @if (ViewBag.Error != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: '<span style="color:var(--gem-ruby)">Error de Acceso</span>',
                    text: '@ViewBag.Error',
                    confirmButtonColor: '#162e55',
                    background: '#ffffff',
                    customClass: { popup: 'border-radius-20' }
                });
                </text>
            }

            // Éxito en Esmeralda
            @if (TempData["MensajeExito"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: '<span style="color:var(--gem-emerald-vivid)">¡Bienvenido!</span>',
                    text: '@TempData["MensajeExito"]',
                    confirmButtonColor: '#10b981',
                    timer: 3000
                });
                </text>
            }
        });
    </script>
</body>
</html>