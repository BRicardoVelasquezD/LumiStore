<!DOCTYPE html>
<html lang="es" prefix="og: http://ogp.me/ns#">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>

    <!-- Organiza sección -->
    <meta name="description" content="Lumi Store · Joyería & Perfumería de Alta Gama. Donde el lujo encuentra su esencia.">
    <meta name="author" content="Lumi Store">
    <meta name="keywords" content="joyería, perfumería, lujo, alta gama, colección premium, boutique digital">

    <!-- Organiza sección -->
    <meta property="og:title" content="@ViewBag.Title">
    <meta property="og:description" content="Descubre joyería y perfumería de alta gama donde cada pieza es una obra de arte.">
    <meta property="og:image" content="https://lumistore.com/content/og-default.jpg">
    <meta property="og:url" content="https://lumistore.com">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Lumi Store">

    <!-- Organiza sección -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@ViewBag.Title">
    <meta name="twitter:description" content="Lumi Store · Joyería & Perfumería de Alta Gama">
    <meta name="twitter:image" content="https://lumistore.com/content/twitter-card.jpg">

    <!-- Organiza sección -->
    <link rel="icon" type="image/x-icon" href="~/Content/favicon.ico">
    <link rel="apple-touch-icon" href="~/Content/apple-touch-icon.png">

    <!-- Organiza sección -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Organiza sección -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <!-- Organiza sección -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">

    <!-- Organiza sección -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- Organiza sección -->
    <link href="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.css" rel="stylesheet">

    <!-- Organiza sección -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">

    @RenderSection("styles", required: false)

    <!-- Organiza sección -->
    <style>
        :root {
            /* Organiza sección */
            --zafiro: #0F52BA;      /* Organiza sección */
            --amatista: #5E3A8C;    /* Organiza sección */
            --esmeralda: #007A5E;   /* Organiza sección */
            --rubi: #9B1C31;        /* Organiza sección */
            --obsidiana: #0C0C0F;   /* Organiza sección */
            --oro: #D1B280;         /* Organiza sección */

            /* Organiza sección */
            --bg-60: #FDFBFB;       /* Organiza sección */
            --bg-30: #F7F8FA;       /* Organiza sección */
            --glass: rgba(255,255,255,0.94);

            /* Organiza sección */
            --text-main: #15181C;    /* Organiza sección */
            --text-muted: #72675A;   /* Organiza sección */
            --text-light: #9A948C;   /* Organiza sección */

            /* Organiza sección */
            --lux-border: rgba(209,178,128,0.18);
            --shadow-soft: 0 12px 30px rgba(12,12,12,0.06);
            --shadow-gold: 0 20px 40px rgba(209,178,128,0.15);

            /* Organiza sección */
            --gradient-lux: linear-gradient(135deg, var(--zafiro), var(--amatista));
            --gradient-gold: linear-gradient(135deg, #F7E7CE, var(--oro));
            --gradient-glass: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(255,255,255,0.85));
        }

        /* Organiza sección */
        body {
            font-family: 'Montserrat', sans-serif;
            background: var(--bg-60);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 700;
        }

        .font-playfair {
            font-family: 'Playfair Display', serif;
        }

        /* Organiza sección */
        .lumi-navbar {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--lux-border);
            padding: 1rem 0;
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.9rem;
            font-weight: 700;
            letter-spacing: 1px;
            color: var(--text-main);
        }

        .navbar-brand i {
            color: var(--zafiro);
        }

        .nav-link {
            font-weight: 500;
            color: var(--text-muted);
            transition: color 0.2s;
            position: relative;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--zafiro);
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            background: var(--gradient-lux);
            bottom: -5px;
            left: 0;
            transition: width 0.3s;
        }

        .nav-link:hover::after, .nav-link.active::after {
            width: 100%;
        }

        /* Organiza sección */
        .btn-cart {
            background: transparent;
            border: 2px solid var(--zafiro);
            color: var(--zafiro);
            border-radius: 50px;
            padding: 0.5rem 1.5rem;
            font-weight: 600;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-cart:hover {
            background: var(--gradient-lux);
            color: white;
            transform: translateY(-2px);
            box-shadow: var(--shadow-soft);
        }

        .cart-badge {
            background: var(--rubi);
            color: white;
            font-size: 0.75rem;
            min-width: 20px;
            height: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* Organiza sección */
        #globalLoadingOverlay {
            position: fixed;
            inset: 0;
            background: var(--glass);
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .loading-gem {
            color: var(--zafiro);
            font-size: 3rem;
            animation: gemPulse 1.5s ease-in-out infinite;
        }

        @@keyframes gemPulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.1); opacity: 0.8; }
        }

        /* Organiza sección */
        footer {
            background: var(--bg-30);
            border-top: 1px solid var(--lux-border);
            padding: 3rem 0;
            margin-top: 5rem;
        }

        .footer-logo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .footer-links a {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s;
        }

        .footer-links a:hover {
            color: var(--zafiro);
        }

        /* Organiza sección */
        .text-neon {
            background: var(--gradient-lux);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .bg-glass {
            background: var(--glass);
            backdrop-filter: blur(10px);
        }

        .border-lux {
            border: 1px solid var(--lux-border);
        }

        .shadow-lux {
            box-shadow: var(--shadow-soft);
        }

        /* Organiza sección */
        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

        /* Organiza sección */
        @@media (max-width: 768px) {
            .navbar-brand {
                font-size: 1.6rem;
            }

            .btn-cart {
                padding: 0.4rem 1rem;
                font-size: 0.9rem;
            }
        }
    </style>

    <!-- Organiza sección -->
    <script type="application/ld+json">
    {
        "context": "https://schema.org",
        "type": "Organization",
        "name": "Lumi Store",
        "url": "https://lumistore.com",
        "logo": "https://lumistore.com/content/logo.png",
        "description": "Joyería & Perfumería de Alta Gama. Donde el lujo encuentra su esencia.",
        "address": {
            "type": "PostalAddress",
            "addressCountry": "CO"
        },
        "contactPoint": {
            "type": "ContactPoint",
            "contactType": "customer service",
            "email": "concierge@lumistore.com"
        }
    }
    </script>
</head>

<body>
    @Html.AntiForgeryToken()

    <!-- Organiza sección -->
    <div id="globalLoadingOverlay">
        <div class="text-center">
            <div class="loading-gem mb-3">
                <i class="fas fa-gem"></i>
            </div>
            <p class="fw-semibold mb-1" style="color: var(--text-main);">Cargando experiencia Lumi…</p>
            <small class="text-muted">Tecnología · Identidad · Emoción</small>
        </div>
    </div>

    <!-- Organiza sección -->
    <nav class="navbar navbar-expand-lg fixed-top lumi-navbar">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index","Tienda")" aria-label="Lumi Store - Inicio">
                <i class="fas fa-gem me-2"></i>LUMI
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarLumi" aria-controls="navbarLumi"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarLumi">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Tienda" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")"
                           href="@Url.Action("Index","Tienda")">
                            <i class="fas fa-home me-1"></i> Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#coleccion" role="button">
                            <i class="fas fa-crown me-1"></i> Colección
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#exclusivos" role="button">
                            <i class="fas fa-star me-1"></i> Exclusivos
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center">
                    @if (Session["Cliente"] != null)
                    {
                        <div class="dropdown me-3">
                            <button class="btn btn-link nav-link dropdown-toggle" type="button"
                                    id="dropdownMenuUsuario" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fas fa-user-circle me-1"></i>
                                @(((Entidad.Cliente)Session["Cliente"]).Nombres)
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuUsuario">
                                <li><a class="dropdown-item" href="@Url.Action("Carrito","Tienda")"><i class="fas fa-shopping-bag me-2"></i>Mi Historia</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("CerrarSesion","Acceso")"><i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Index","Acceso")" class="nav-link me-3">
                            <i class="fas fa-sign-in-alt me-1"></i> Iniciar Sesión
                        </a>
                    }

                    <a href="@Url.Action("Carrito","Tienda")" class="btn-cart" aria-label="Carrito de compras">
                        <i class="fas fa-shopping-bag"></i>
                        <span>Mi Historia</span>
                        <span id="cantidadCarrito" class="badge cart-badge rounded-pill">0</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Organiza sección -->
    <main class="container-fluid px-0">
        @RenderBody()
    </main>

    <!-- Organiza sección -->
    <footer class="mt-auto">
        <div class="container">
            <div class="row align-items-center py-4">
                <!-- Organiza sección -->
                <div class="col-lg-4 text-center text-lg-start mb-4 mb-lg-0">
                    <div class="footer-logo mb-3">
                        <i class="fas fa-gem me-2" style="color: var(--zafiro);"></i>
                        <span style="font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; font-weight: 700; color: var(--text-main);">LUMI</span>
                    </div>
                    <p class="text-muted small mb-0" style="color: var(--text-muted);">
                        Joyería & Perfumería de Alta Gama<br>
                        Donde el lujo encuentra su esencia
                    </p>
                </div>

                <!-- Organiza sección -->
                <div class="col-lg-4 text-center mb-4 mb-lg-0">
                    <div class="footer-links d-flex justify-content-center gap-4 flex-wrap">
                        <a href="@Url.Action("Index","Tienda")"
                           class="text-decoration-none"
                           style="color: var(--text-muted); transition: color 0.2s;"
                           onmouseover="this.style.color='var(--zafiro)'"
                           onmouseout="this.style.color='var(--text-muted)'"
                           aria-label="Ir a Inicio">
                            Inicio
                        </a>
                        <a href="@Url.Action("Index","Tienda")#coleccion"
                           class="text-decoration-none"
                           style="color: var(--text-muted); transition: color 0.2s;"
                           onmouseover="this.style.color='var(--zafiro)'"
                           onmouseout="this.style.color='var(--text-muted)'"
                           aria-label="Ver Colección">
                            Colección
                        </a>
                        <a href="#"
                           class="text-decoration-none"
                           style="color: var(--text-muted); transition: color 0.2s;"
                           onmouseover="this.style.color='var(--zafiro)'"
                           onmouseout="this.style.color='var(--text-muted)'"
                           aria-label="Sobre Nosotros">
                            Nosotros
                        </a>
                        <a href="#"
                           class="text-decoration-none"
                           style="color: var(--text-muted); transition: color 0.2s;"
                           onmouseover="this.style.color='var(--zafiro)'"
                           onmouseout="this.style.color='var(--text-muted)'"
                           aria-label="Contactar">
                            Contacto
                        </a>
                    </div>
                </div>

                <!-- Organiza sección -->
                <div class="col-lg-4 text-center text-lg-end">
                    <div class="mb-3">
                        <p class="small mb-1" style="color: var(--text-muted);">
                            <i class="fas fa-shield-alt me-1" style="color: var(--esmeralda);"></i> Compra 100% segura
                        </p>
                        <p class="small mb-1" style="color: var(--text-muted);">
                            <i class="fas fa-truck me-1" style="color: var(--zafiro);"></i> Envío premium certificado
                        </p>
                        <p class="small mb-0" style="color: var(--text-muted);">
                            <i class="fas fa-undo me-1" style="color: var(--oro);"></i> 14 días devolución
                        </p>
                    </div>

                    <div class="mt-3">
                        <a href="#"
                           class="text-decoration-none me-3"
                           style="color: var(--text-muted); transition: color 0.2s; font-size: 1.2rem;"
                           onmouseover="this.style.color='#E1306C'"
                           onmouseout="this.style.color='var(--text-muted)'"
                           aria-label="Síguenos en Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#"
                           class="text-decoration-none me-3"
                           style="color: var(--text-muted); transition: color 0.2s; font-size: 1.2rem;"
                           onmouseover="this.style.color='#1877F2'"
                           onmouseout="this.style.color='var(--text-muted)'"
                           aria-label="Síguenos en Facebook">
                            <i class="fab fa-facebook"></i>
                        </a>
                        <a href="#"
                           class="text-decoration-none"
                           style="color: var(--text-muted); transition: color 0.2s; font-size: 1.2rem;"
                           onmouseover="this.style.color='#E60023'"
                           onmouseout="this.style.color='var(--text-muted)'"
                           aria-label="Síguenos en Pinterest">
                            <i class="fab fa-pinterest"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Organiza sección -->
            <hr class="my-4" style="border-color: var(--lux-border); opacity: 0.3;">

            <!-- Organiza sección -->
            <div class="row">
                <div class="col-12 text-center">
                    <p class="small mb-0" style="color: var(--text-muted);">
                        &copy; @DateTime.Now.Year Lumi Store. Todos los derechos reservados.<br>
                        <span class="d-block mt-1" style="color: var(--text-light); font-size: 0.9rem;">
                            Una experiencia
                            <span style="background: linear-gradient(135deg, var(--zafiro), var(--amatista)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 600;">
                                Luxury Digital Boutique
                            </span>
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Organiza sección -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>

    <script>
        // Organiza sección
        $(window).on('load', function () {
            $('#globalLoadingOverlay').fadeOut(600);
        });

        // Organiza sección
        function actualizarCarrito() {
            $.get('@Url.Action("CantidadEnCarrito","Tienda")', function (data) {
                if (data && data.cantidad !== undefined) {
                    $('#cantidadCarrito').text(data.cantidad);
                }
            }).fail(function () {
                console.log('Error al actualizar carrito');
            });
        }

        // Organiza sección
        function mostrarNotificacionLumi(titulo, mensaje, tipo = 'success') {
            const iconos = {
                success: 'fas fa-check-circle',
                error: 'fas fa-exclamation-circle',
                warning: 'fas fa-exclamation-triangle',
                info: 'fas fa-info-circle'
            };

            Swal.fire({
                title: titulo,
                text: mensaje,
                icon: tipo,
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                background: 'var(--bg-60)',
                color: 'var(--text-main)',
                customClass: {
                    title: 'font-playfair'
                }
            });
        }

        // Organiza sección
        function trackEvent(evento, datos = {}) {
            if (window.dataLayer) {
                dataLayer.push({
                    'event': evento,
                    ...datos
                });
            }
        }

        // Organiza sección
        $(function () {
            // Organiza sección
            actualizarCarrito();

            // Organiza sección
            $('a[href^="#"]').on('click', function (e) {
                if (this.hash !== '') {
                    e.preventDefault();
                    const hash = this.hash;
                    $('html, body').animate({
                        scrollTop: $(hash).offset().top - 80
                    }, 800);
                }
            });

            // Organiza sección
            $(window).on('scroll', function () {
                if ($(window).scrollTop() > 50) {
                    $('.lumi-navbar').addClass('navbar-scrolled');
                } else {
                    $('.lumi-navbar').removeClass('navbar-scrolled');
                }
            });

            // Organiza sección
            $('[aria-label]').each(function() {
                const label = $(this).attr('aria-label');
                $(this).attr('title', label);
            });

            // Organiza sección
            $('#currentYear').text(new Date().getFullYear());
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>