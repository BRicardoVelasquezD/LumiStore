@{
    ViewBag.Title = "Estado del pago";
}

<main class="container py-5">
    <section class="card mx-auto p-4 shadow-sm text-center" style="max-width: 640px;">
        <i class="fas fa-info-circle text-primary display-4"></i>
        <h1 class="mt-3">Estado del pago</h1>
        <p>@ViewBag.Mensaje</p>
        <a class="btn btn-primary mt-3" href="@Url.Action("Carrito", "Tienda")">Volver al carrito</a>
    </section>
</main>
