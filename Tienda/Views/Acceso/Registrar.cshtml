@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Solicitud de Membresía - Lumi Store</title>

    <!-- Organiza sección -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Organiza sección -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <!-- Organiza sección -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@200;300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            /* Organiza sección */
            --zafiro-deep: #0d1c36;
            --zafiro-light: #2a4a7e;
            --coral-soft: #FF6B6B;
            --fancy-pink: #ff85a2;
            --pink-glow: rgba(255, 133, 162, 0.3);
            --oro-champan: #F5E9C8;
            --oro-light: #FFF9E6;
            --blanco-seda: #F8F5F0;
            --blanco-pure: #FFFFFF;
            --esmeralda-lumi: #10b981;
            --esmeralda-glow: rgba(16, 185, 129, 0.2);
            /* Organiza sección */
            --gradient-gold: linear-gradient(135deg, #F5E9C8 0%, #FFF9E6 100%);
            --gradient-zafiro: linear-gradient(135deg, #0d1c36 0%, #2a4a7e 100%);
            --gradient-pink: linear-gradient(135deg, #ff85a2 0%, #FF6B6B 100%);
            --gradient-gem: linear-gradient(135deg, #ff85a2 0%, #FF6B6B 50%, #0d1c36 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: var(--blanco-seda);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 2rem 1rem;
            position: relative;
            overflow-x: hidden;
        }

        /* Organiza sección */
        .luxury-particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .luxury-particle {
            position: absolute;
            background: var(--pink-glow);
            border-radius: 50%;
            animation: float 20s infinite linear;
        }

        @@keyframes float {
            0% {
                transform: translateY(0) rotate(0deg);
            }

            100% {
                transform: translateY(-1000px) rotate(720deg);
            }
        }

        /* Organiza sección */
        .registration-container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 520px;
        }

        /* Organiza sección */
        .registration-card-premium {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 30px;
            box-shadow: 0 30px 80px rgba(13, 28, 54, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
            position: relative;
            animation: cardEntrance 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @@keyframes cardEntrance {
            from {
                opacity: 0;
                transform: translateY(40px) scale(0.95);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .registration-card-premium::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-gem);
            z-index: 10;
        }

        /* Organiza sección */
        .registration-header-premium {
            padding: 3.5rem 3rem 2.5rem;
            text-align: center;
            background: linear-gradient(135deg, rgba(248, 245, 240, 0.9) 0%, rgba(255, 255, 255, 0.9) 100%);
            position: relative;
            overflow: hidden;
        }

            .registration-header-premium::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><defs><pattern id="pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="1" fill="%23ff85a2" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23pattern)"/></svg>');
                opacity: 0.3;
            }

        .gem-icon-container {
            position: relative;
            display: inline-block;
            margin-bottom: 2rem;
        }

        .gem-icon-premium {
            font-size: 4rem;
            color: var(--fancy-pink);
            filter: drop-shadow(0 10px 20px rgba(255, 133, 162, 0.3));
            position: relative;
            z-index: 2;
            animation: gem-sparkle 3s infinite ease-in-out;
        }

        @@keyframes gem-sparkle {
            0%, 100% {
                transform: translateY(0) rotate(0deg) scale(1);
                filter: drop-shadow(0 5px 15px rgba(255, 133, 162, 0.3));
            }

            50% {
                transform: translateY(-10px) rotate(10deg) scale(1.1);
                filter: drop-shadow(0 15px 30px rgba(255, 133, 162, 0.5));
            }
        }

        .gem-icon-glow {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--pink-glow) 0%, transparent 70%);
            z-index: 1;
            animation: pulse 3s infinite ease-in-out;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 0.3;
                transform: translate(-50%, -50%) scale(0.8);
            }

            50% {
                opacity: 0.6;
                transform: translate(-50%, -50%) scale(1.2);
            }
        }

        .registration-title-premium {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 700;
            font-size: 2.8rem;
            background: var(--gradient-zafiro);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 3px;
            margin-bottom: 1rem;
            text-transform: uppercase;
            position: relative;
            display: inline-block;
        }

            .registration-title-premium::after {
                content: '';
                position: absolute;
                bottom: -8px;
                left: 50%;
                transform: translateX(-50%);
                width: 100px;
                height: 3px;
                background: var(--gradient-pink);
                border-radius: 3px;
            }

        .registration-subtitle-premium {
            font-size: 1.1rem;
            color: #666666;
            font-weight: 300;
            line-height: 1.6;
            max-width: 380px;
            margin: 1.5rem auto 0;
            opacity: 0.9;
        }

        /* Organiza sección */
        .registration-body-premium {
            padding: 0 3rem 3rem;
        }

        /* Organiza sección */
        .form-group-premium {
            margin-bottom: 1.5rem;
            position: relative;
        }

        .form-control-premium {
            width: 100%;
            padding: 1.2rem 1.5rem;
            border-radius: 15px;
            border: 2px solid rgba(245, 233, 200, 0.5);
            background: rgba(248, 245, 240, 0.3);
            color: var(--zafiro-deep);
            font-size: 1rem;
            font-weight: 300;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .form-control-premium:focus {
                border-color: var(--fancy-pink);
                background: white;
                box-shadow: 0 0 0 0.25rem rgba(255, 133, 162, 0.1);
                outline: none;
            }

            .form-control-premium::placeholder {
                color: #666666;
                opacity: 0.7;
                font-weight: 300;
            }

        /* Organiza sección */
        .input-icon-premium {
            position: absolute;
            right: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--fancy-pink);
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }

        .form-group-premium.focused .input-icon-premium {
            color: var(--zafiro-deep);
            transform: translateY(-50%) scale(1.1);
        }

        /* Organiza sección */
        .alert-premium {
            background: rgba(255, 107, 107, 0.1);
            color: var(--coral-soft);
            border: 1px solid rgba(255, 107, 107, 0.2);
            border-radius: 12px;
            font-size: 0.9rem;
            padding: 1rem 1.2rem;
            text-align: center;
            margin-bottom: 1.8rem;
            backdrop-filter: blur(10px);
            font-weight: 300;
            animation: fadeIn 0.5s ease;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert-premium i {
            margin-right: 8px;
        }

        /* Organiza sección */
        .btn-register-premium {
            background: var(--gradient-zafiro);
            color: white;
            border: none;
            border-radius: 15px;
            padding: 1.3rem;
            font-size: 1.1rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
            position: relative;
            overflow: hidden;
            z-index: 1;
            box-shadow: 0 10px 30px rgba(13, 28, 54, 0.25);
            margin-top: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

            .btn-register-premium::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 0;
                height: 100%;
                background: var(--gradient-pink);
                transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
                z-index: -1;
            }

            .btn-register-premium:hover {
                transform: translateY(-3px);
                box-shadow: 0 20px 40px rgba(255, 133, 162, 0.3);
                letter-spacing: 3px;
            }

                .btn-register-premium:hover::before {
                    width: 100%;
                }

            .btn-register-premium i {
                transition: transform 0.4s ease;
            }

            .btn-register-premium:hover i {
                transform: translateX(5px) scale(1.1);
            }

        /* Organiza sección */
        .member-link-premium {
            display: block;
            margin-top: 2.5rem;
            color: #666666;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 300;
            transition: all 0.3s ease;
            text-align: center;
            position: relative;
            padding: 0.5rem 0;
        }

            .member-link-premium:hover {
                color: var(--zafiro-deep);
                text-decoration: none;
            }

            .member-link-premium::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 0;
                height: 1px;
                background: var(--gradient-pink);
                transition: width 0.3s ease;
            }

            .member-link-premium:hover::after {
                width: 100px;
            }

            .member-link-premium i {
                margin-right: 8px;
                transition: transform 0.3s ease;
            }

            .member-link-premium:hover i {
                transform: translateX(-5px);
            }

        /* Organiza sección */
        .corner-decoration {
            position: absolute;
            bottom: 20px;
            right: 20px;
            color: rgba(255, 133, 162, 0.1);
            font-size: 3rem;
            transform: rotate(15deg);
        }

        /* Organiza sección */
        @@media (max-width: 576px) {
            body {
                padding: 1rem;
            }

            .registration-card-premium {
                border-radius: 25px;
            }

            .registration-header-premium {
                padding: 2.5rem 1.5rem 1.5rem;
            }

            .registration-body-premium {
                padding: 0 1.5rem 2.5rem;
            }

            .registration-title-premium {
                font-size: 2.2rem;
            }

            .gem-icon-premium {
                font-size: 3.5rem;
            }

            .form-control-premium {
                padding: 1rem 1.2rem;
            }

            .btn-register-premium {
                padding: 1.1rem;
                font-size: 1rem;
            }
        }

        @@media (max-width: 400px) {
            .registration-title-premium {
                font-size: 1.8rem;
            }

            .registration-subtitle-premium {
                font-size: 1rem;
            }

            .gem-icon-premium {
                font-size: 3rem;
            }
        }

        /* Organiza sección */
        .form-group-premium {
            opacity: 0;
            transform: translateY(20px);
            animation: fieldEntrance 0.6s ease forwards;
        }

        @@keyframes fieldEntrance {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-group-premium:nth-child(1) {
            animation-delay: 0.1s;
        }

        .form-group-premium:nth-child(2) {
            animation-delay: 0.2s;
        }

        .form-group-premium:nth-child(3) {
            animation-delay: 0.3s;
        }

        .form-group-premium:nth-child(4) {
            animation-delay: 0.4s;
        }

        .form-group-premium:nth-child(5) {
            animation-delay: 0.5s;
        }

        /* Organiza sección */
        .form-control-premium.valid {
            border-color: var(--esmeralda-lumi);
            background: rgba(16, 185, 129, 0.05);
        }

        .form-control-premium.invalid {
            border-color: var(--coral-soft);
            background: rgba(255, 107, 107, 0.05);
        }

        .password-strength {
            margin-top: 0.5rem;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 5px;
            opacity: 0;
            transform: translateY(-10px);
            transition: all 0.3s ease;
        }

            .password-strength.show {
                opacity: 1;
                transform: translateY(0);
            }

        .strength-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(245, 233, 200, 0.5);
            transition: all 0.3s ease;
        }

            .strength-dot.active {
                background: var(--esmeralda-lumi);
                transform: scale(1.2);
            }
    </style>
</head>
<body>
    <!-- Organiza sección -->
    <div class="luxury-particles" id="luxuryParticles"></div>

    <div class="registration-container">
        <div class="registration-card-premium">
            <!-- Organiza sección -->
            <div class="corner-decoration">
                <i class="fas fa-feather"></i>
            </div>

            <!-- Organiza sección -->
            <div class="registration-header-premium">
                <div class="gem-icon-container">
                    <div class="gem-icon-glow"></div>
                    <i class="fas fa-gem gem-icon-premium"></i>
                </div>

                <h2 class="registration-title-premium">SOLICITAR MEMBRESÍA</h2>
                <p class="registration-subtitle-premium">
                    Únete a nuestro círculo exclusivo de coleccionistas.
                    Cada membresía es personal y cuidadosamente curada.
                </p>
            </div>

            <!-- Organiza sección -->
            <div class="registration-body-premium">
                <form action="@Url.Action("Registrar","Acceso")" method="post" id="registerForm">
                    <!-- Organiza sección -->
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group-premium">
                                <input type="text" name="Nombres" class="form-control-premium"
                                       placeholder="Tus nombres" required>
                                <span class="input-icon-premium">
                                    <i class="fas fa-user"></i>
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group-premium">
                                <input type="text" name="Apellidos" class="form-control-premium"
                                       placeholder="Tus apellidos" required>
                                <span class="input-icon-premium">
                                    <i class="fas fa-user-tag"></i>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group-premium">
                        <input type="email" name="Correo" class="form-control-premium"
                               placeholder="Correo electrónico exclusivo" required>
                        <span class="input-icon-premium">
                            <i class="fas fa-envelope"></i>
                        </span>
                    </div>

                    <div class="form-group-premium">
                        <input type="password" name="Clave" class="form-control-premium"
                               placeholder="Crea tu clave de acceso" required>
                        <span class="input-icon-premium">
                            <i class="fas fa-lock"></i>
                        </span>
                        <div class="password-strength" id="passwordStrength">
                            <span class="strength-dot"></span>
                            <span class="strength-dot"></span>
                            <span class="strength-dot"></span>
                            <span class="strength-dot"></span>
                            <span style="margin-left: 10px; font-size: 0.8rem; color: #666666;" id="strengthText">Seguridad</span>
                        </div>
                    </div>

                    <!-- Organiza sección -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert-premium py-2 mb-3">
                            <i class="fas fa-info-circle"></i> @ViewBag.Error
                        </div>
                    }

                    <!-- Organiza sección -->
                    <button class="btn btn-register-premium" type="submit">
                        <i class="fas fa-star"></i> SOLICITAR MEMBRESÍA
                    </button>

                    <!-- Organiza sección -->
                    <div class="text-center">
                        <a href="@Url.Action("Index")" class="member-link-premium">
                            <i class="fas fa-arrow-left"></i> Ya tengo una membresía, ingresar al salón
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Organiza sección -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>

    <script>
        $(document).ready(function () {
            // Organiza sección
            createParticles();

            // Organiza sección
            $.LoadingOverlaySetup({
                background: "rgba(248, 245, 240, 0.95)",
                custom: $("<div>", {
                    style: "text-align: center;"
                }).append(
                    $("<div>", {
                        style: "position: relative; margin-bottom: 20px;"
                    }).append(
                        $("<i>", {
                            class: "fas fa-gem",
                            style: "color: var(--fancy-pink); font-size: 60px; display: block; animation: gem-sparkle 2s infinite ease-in-out;"
                        }),
                        $("<div>", {
                            style: "position: absolute; width: 100px; height: 100px; border-radius: 50%; background: radial-gradient(circle, var(--pink-glow) 0%, transparent 70%); top: 50%; left: 50%; transform: translate(-50%, -50%); animation: pulse 2s infinite ease-in-out;"
                        })
                    ),
                    $("<p>", {
                        text: "CREANDO TU ESPACIO EXCLUSIVO...",
                        style: "color: #666666; font-family: 'Montserrat', sans-serif; font-weight: 300; letter-spacing: 2px; margin-top: 20px; font-size: 0.9rem;"
                    })
                ),
                text: "",
                textColor: "#666666"
            });

            // Organiza sección
            $("#registerForm").submit(function () {
                $.LoadingOverlay("show");
            });

            // Organiza sección
            $(".form-control-premium").focus(function () {
                $(this).closest(".form-group-premium").addClass("focused");
            }).blur(function () {
                if ($(this).val() === "") {
                    $(this).closest(".form-group-premium").removeClass("focused");
                }
            });

            // Organiza sección
            $("input[name='Correo']").on('input', function () {
                const email = $(this).val();
                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

                if (email) {
                    if (emailRegex.test(email)) {
                        $(this).removeClass('invalid').addClass('valid');
                        $(this).next('.input-icon-premium').css('color', 'var(--esmeralda-lumi)');
                    } else {
                        $(this).removeClass('valid').addClass('invalid');
                        $(this).next('.input-icon-premium').css('color', 'var(--coral-soft)');
                    }
                } else {
                    $(this).removeClass('valid invalid');
                    $(this).next('.input-icon-premium').css('color', 'var(--fancy-pink)');
                }
            });

            // Organiza sección
            $("input[name='Clave']").on('input', function () {
                const password = $(this).val();
                const strengthContainer = $("#passwordStrength");
                const dots = strengthContainer.find('.strength-dot');
                const strengthText = $("#strengthText");

                if (password.length > 0) {
                    strengthContainer.addClass('show');

                    // Organiza sección
                    let strength = 0;
                    if (password.length >= 8) strength++;
                    if (/[A-Z]/.test(password)) strength++;
                    if (/[0-9]/.test(password)) strength++;
                    if (/[^A-Za-z0-9]/.test(password)) strength++;

                    // Organiza sección
                    dots.removeClass('active');
                    for (let i = 0; i < strength; i++) {
                        $(dots[i]).addClass('active');
                    }

                    // Organiza sección
                    const texts = ['Débil', 'Moderada', 'Buena', 'Excelente'];
                    strengthText.text(texts[strength - 1] || 'Débil');
                    strengthText.css('color',
                        strength >= 3 ? 'var(--esmeralda-lumi)' :
                            strength >= 2 ? 'var(--oro-champan)' :
                                'var(--coral-soft)'
                    );

                    // Organiza sección
                    if (strength >= 3) {
                        $(this).removeClass('invalid').addClass('valid');
                        $(this).next('.input-icon-premium').css('color', 'var(--esmeralda-lumi)');
                    } else if (strength >= 1) {
                        $(this).removeClass('valid').addClass('invalid');
                        $(this).next('.input-icon-premium').css('color', 'var(--coral-soft)');
                    } else {
                        $(this).removeClass('valid invalid');
                        $(this).next('.input-icon-premium').css('color', 'var(--fancy-pink)');
                    }
                } else {
                    strengthContainer.removeClass('show');
                    $(this).removeClass('valid invalid');
                    $(this).next('.input-icon-premium').css('color', 'var(--fancy-pink)');
                }
            });

            // Organiza sección
            $("input[name='Nombres'], input[name='Apellidos']").on('input', function () {
                const value = $(this).val();
                if (value) {
                    if (/^[A-Za-zÁÉÍÓÚáéíóúÑñ\s]+$/.test(value)) {
                        $(this).removeClass('invalid').addClass('valid');
                        $(this).next('.input-icon-premium').css('color', 'var(--esmeralda-lumi)');
                    } else {
                        $(this).removeClass('valid').addClass('invalid');
                        $(this).next('.input-icon-premium').css('color', 'var(--coral-soft)');
                    }
                } else {
                    $(this).removeClass('valid invalid');
                    $(this).next('.input-icon-premium').css('color', 'var(--fancy-pink)');
                }
            });

            // Organiza sección
            function createParticles() {
                const container = $('#luxuryParticles');
                const particleCount = 15;

                for (let i = 0; i < particleCount; i++) {
                    const size = Math.random() * 4 + 1;
                    const posX = Math.random() * 100;
                    const posY = Math.random() * 100;
                    const delay = Math.random() * 20;
                    const duration = Math.random() * 20 + 10;
                    const opacity = Math.random() * 0.1 + 0.05;

                    const particle = $('<div class="luxury-particle"></div>').css({
                        width: size + 'px',
                        height: size + 'px',
                        left: posX + 'vw',
                        top: posY + 'vh',
                        background: `rgba(${Math.random() * 50 + 180}, ${Math.random() * 50 + 100}, ${Math.random() * 50 + 200}, ${opacity})`,
                        animationDelay: delay + 's',
                        animationDuration: duration + 's'
                    });

                    container.append(particle);
                }
            }

            // Organiza sección
            setTimeout(() => {
                $('.form-group-premium').each(function (i) {
                    $(this).css({
                        'opacity': '0',
                        'transform': 'translateY(20px)'
                    });

                    setTimeout(() => {
                        $(this).css({
                            'opacity': '1',
                            'transform': 'translateY(0)',
                            'transition': 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)'
                        });
                    }, i * 100);
                });
            }, 300);
        });
    </script>
</body>
</html>