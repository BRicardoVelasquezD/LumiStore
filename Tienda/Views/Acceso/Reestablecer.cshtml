@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Recuperar Acceso Exclusivo - Lumi Store</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <!-- Fuentes premium -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@200;300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            /* Paleta Lumi Store Premium */
            --zafiro-deep: #0d1c36;
            --zafiro-light: #2a4a7e;
            --coral-soft: #FF6B6B;
            --fancy-pink: #ff85a2;
            --pink-glow: rgba(255, 133, 162, 0.3);
            --oro-champan: #F5E9C8;
            --oro-light: #FFF9E6;
            --blanco-seda: #F8F5F0;
            --blanco-pure: #FFFFFF;
            --esmeralda-lumi: #10b981;
            --esmeralda-glow: rgba(16, 185, 129, 0.2);
            --texto-suave: #6b7280;
            /* Gradientes exclusivos */
            --gradient-gold: linear-gradient(135deg, #F5E9C8 0%, #FFF9E6 100%);
            --gradient-zafiro: linear-gradient(135deg, #0d1c36 0%, #2a4a7e 100%);
            --gradient-pink: linear-gradient(135deg, #ff85a2 0%, #FF6B6B 100%);
            --gradient-gem: linear-gradient(135deg, #ff85a2 0%, #FF6B6B 50%, #0d1c36 100%);
            /* Sombras premium */
            --shadow-premium: 0 30px 80px rgba(13, 28, 54, 0.15);
            --shadow-glow: 0 0 50px rgba(255, 133, 162, 0.25);
            --shadow-soft: 0 10px 40px rgba(0, 0, 0, 0.05);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: var(--blanco-seda);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 2rem 1rem;
            position: relative;
            overflow-x: hidden;
        }

        /* Partículas de fondo */
        .recovery-particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .recovery-particle {
            position: absolute;
            background: var(--pink-glow);
            border-radius: 50%;
            animation: float 20s infinite linear;
        }

        @@keyframes float {
            0% {
                transform: translateY(0) rotate(0deg);
            }

            100% {
                transform: translateY(-1000px) rotate(720deg);
            }
        }

        /* Contenedor principal */
        .recovery-container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 480px;
        }

        /* Tarjeta de recuperación premium */
        .recovery-card-premium {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 30px;
            box-shadow: var(--shadow-premium);
            border: 1px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
            position: relative;
            animation: cardEntrance 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @@keyframes cardEntrance {
            from {
                opacity: 0;
                transform: translateY(40px) scale(0.95);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .recovery-card-premium::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-gem);
            z-index: 10;
        }

        /* Header premium */
        .recovery-header-premium {
            padding: 3.5rem 3rem 2.5rem;
            text-align: center;
            background: linear-gradient(135deg, rgba(248, 245, 240, 0.9) 0%, rgba(255, 255, 255, 0.9) 100%);
            position: relative;
            overflow: hidden;
        }

            .recovery-header-premium::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><defs><pattern id="pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="1" fill="%23ff85a2" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23pattern)"/></svg>');
                opacity: 0.3;
            }

        .key-icon-container {
            position: relative;
            display: inline-block;
            margin-bottom: 2rem;
        }

        .key-icon-premium {
            font-size: 4rem;
            color: var(--fancy-pink);
            filter: drop-shadow(0 10px 20px rgba(255, 133, 162, 0.3));
            position: relative;
            z-index: 2;
            animation: keyFloat 3s infinite ease-in-out;
        }

        @@keyframes keyFloat {
            0%, 100% {
                transform: translateY(0) rotate(0deg) scale(1);
                filter: drop-shadow(0 5px 15px rgba(255, 133, 162, 0.3));
            }

            50% {
                transform: translateY(-10px) rotate(-5deg) scale(1.1);
                filter: drop-shadow(0 15px 30px rgba(255, 133, 162, 0.5));
            }
        }

        .key-icon-glow {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--pink-glow) 0%, transparent 70%);
            z-index: 1;
            animation: pulse 3s infinite ease-in-out;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 0.3;
                transform: translate(-50%, -50%) scale(0.8);
            }

            50% {
                opacity: 0.6;
                transform: translate(-50%, -50%) scale(1.2);
            }
        }

        .recovery-title-premium {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 700;
            font-size: 2.5rem;
            background: var(--gradient-zafiro);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 2px;
            margin-bottom: 1rem;
            text-transform: uppercase;
            position: relative;
            display: inline-block;
        }

            .recovery-title-premium::after {
                content: '';
                position: absolute;
                bottom: -8px;
                left: 50%;
                transform: translateX(-50%);
                width: 100px;
                height: 3px;
                background: var(--gradient-pink);
                border-radius: 3px;
            }

        .recovery-subtitle-premium {
            font-size: 1.1rem;
            color: var(--texto-suave);
            font-weight: 300;
            line-height: 1.6;
            max-width: 380px;
            margin: 1.5rem auto 0;
            opacity: 0.9;
        }

        /* Formulario premium */
        .recovery-body-premium {
            padding: 0 3rem 3rem;
        }

        /* Campo del formulario */
        .form-group-premium {
            margin-bottom: 1.5rem;
            position: relative;
        }

        .form-control-premium {
            width: 100%;
            padding: 1.2rem 1.5rem;
            border-radius: 15px;
            border: 2px solid rgba(245, 233, 200, 0.5);
            background: rgba(248, 245, 240, 0.3);
            color: var(--zafiro-deep);
            font-size: 1rem;
            font-weight: 300;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            text-align: center;
        }

            .form-control-premium:focus {
                border-color: var(--fancy-pink);
                background: white;
                box-shadow: 0 0 0 0.25rem rgba(255, 133, 162, 0.1);
                outline: none;
            }

            .form-control-premium::placeholder {
                color: var(--texto-suave);
                opacity: 0.7;
                font-weight: 300;
            }

        /* Icono en campo */
        .input-icon-premium {
            position: absolute;
            right: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--fancy-pink);
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }

        .form-group-premium.focused .input-icon-premium {
            color: var(--zafiro-deep);
            transform: translateY(-50%) scale(1.1);
        }

        /* Mensaje de error */
        .alert-premium {
            background: rgba(255, 107, 107, 0.1);
            color: var(--coral-soft);
            border: 1px solid rgba(255, 107, 107, 0.2);
            border-radius: 12px;
            font-size: 0.9rem;
            padding: 1rem 1.2rem;
            text-align: center;
            margin-bottom: 1.8rem;
            backdrop-filter: blur(10px);
            font-weight: 300;
            animation: fadeIn 0.5s ease;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert-premium i {
            margin-right: 8px;
        }

        /* Botón de envío */
        .btn-send-premium {
            background: var(--gradient-zafiro);
            color: white;
            border: none;
            border-radius: 15px;
            padding: 1.3rem;
            font-size: 1.1rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
            position: relative;
            overflow: hidden;
            z-index: 1;
            box-shadow: 0 10px 30px rgba(13, 28, 54, 0.25);
            margin-top: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

            .btn-send-premium::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 0;
                height: 100%;
                background: var(--gradient-pink);
                transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
                z-index: -1;
            }

            .btn-send-premium:hover {
                transform: translateY(-3px);
                box-shadow: 0 20px 40px rgba(255, 133, 162, 0.3);
                letter-spacing: 3px;
            }

                .btn-send-premium:hover::before {
                    width: 100%;
                }

            .btn-send-premium i {
                transition: transform 0.4s ease;
            }

            .btn-send-premium:hover i {
                transform: translateX(5px) scale(1.1);
            }

        /* Enlace de regreso */
        .back-link-premium {
            display: block;
            margin-top: 2.5rem;
            color: var(--texto-suave);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 300;
            transition: all 0.3s ease;
            text-align: center;
            position: relative;
            padding: 0.5rem 0;
        }

            .back-link-premium:hover {
                color: var(--zafiro-deep);
                text-decoration: none;
            }

            .back-link-premium::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 0;
                height: 1px;
                background: var(--gradient-pink);
                transition: width 0.3s ease;
            }

            .back-link-premium:hover::after {
                width: 100px;
            }

            .back-link-premium i {
                margin-right: 8px;
                transition: transform 0.3s ease;
            }

            .back-link-premium:hover i {
                transform: translateX(-5px);
            }

        /* Decoraciones */
        .corner-decoration {
            position: absolute;
            bottom: 20px;
            right: 20px;
            color: rgba(255, 133, 162, 0.1);
            font-size: 3rem;
            transform: rotate(15deg);
        }

        /* Responsividad */
        @@media (max-width: 576px) {
            body {
                padding: 1rem;
            }

            .recovery-card-premium {
                border-radius: 25px;
            }

            .recovery-header-premium {
                padding: 2.5rem 1.5rem 1.5rem;
            }

            .recovery-body-premium {
                padding: 0 1.5rem 2.5rem;
            }

            .recovery-title-premium {
                font-size: 2rem;
            }

            .key-icon-premium {
                font-size: 3.5rem;
            }

            .form-control-premium {
                padding: 1rem 1.2rem;
            }

            .btn-send-premium {
                padding: 1.1rem;
                font-size: 1rem;
            }
        }

        @@media (max-width: 400px) {
            .recovery-title-premium {
                font-size: 1.8rem;
            }

            .recovery-subtitle-premium {
                font-size: 1rem;
            }

            .key-icon-premium {
                font-size: 3rem;
            }
        }

        /* Efectos de validación */
        .form-control-premium.valid {
            border-color: var(--esmeralda-lumi);
            background: rgba(16, 185, 129, 0.05);
        }

        .form-control-premium.invalid {
            border-color: var(--coral-soft);
            background: rgba(255, 107, 107, 0.05);
        }

        /* Mensaje de éxito */
        .success-message-premium {
            background: rgba(16, 185, 129, 0.1);
            color: var(--esmeralda-lumi);
            border: 1px solid rgba(16, 185, 129, 0.2);
            border-radius: 12px;
            font-size: 0.9rem;
            padding: 1rem 1.2rem;
            text-align: center;
            margin-bottom: 1.8rem;
            backdrop-filter: blur(10px);
            font-weight: 300;
            animation: fadeIn 0.5s ease;
        }

            .success-message-premium i {
                margin-right: 8px;
            }

        /* Animación para el formulario al cargar */
        .form-group-premium {
            opacity: 0;
            transform: translateY(20px);
        }

        /* Spinner de carga */
        .loading-spinner {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(248, 245, 240, 0.95);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .spinner-content {
            text-align: center;
        }

            .spinner-content i {
                font-size: 4rem;
                color: var(--fancy-pink);
                animation: keyFloat 2s infinite ease-in-out;
            }

            .spinner-content p {
                margin-top: 20px;
                color: var(--texto-suave);
                font-weight: 300;
                letter-spacing: 2px;
            }
    </style>
</head>
<body>
    <!-- Partículas de fondo -->
    <div class="recovery-particles" id="recoveryParticles"></div>

    <div class="recovery-container">
        <div class="recovery-card-premium">
            <!-- Decoración de esquina -->
            <div class="corner-decoration">
                <i class="fas fa-feather"></i>
            </div>

            <!-- Header -->
            <div class="recovery-header-premium">
                <div class="key-icon-container">
                    <div class="key-icon-glow"></div>
                    <i class="fas fa-key key-icon-premium"></i>
                </div>

                <h2 class="recovery-title-premium">RECUPERAR ACCESO</h2>
                <p class="recovery-subtitle-premium">
                    Te enviaremos instrucciones exclusivas para restablecer tu acceso al salón privado de Lumi Store.
                </p>
            </div>

            <!-- Formulario -->
            <div class="recovery-body-premium">
                <form action="@Url.Action("Reestablecer","Acceso")" method="post" id="recoveryForm">
                    <!-- Campo de email -->
                    <div class="form-group-premium">
                        <input type="email" name="correo" class="form-control-premium"
                               placeholder="Ingresa tu correo registrado" required id="emailInput">
                        <span class="input-icon-premium">
                            <i class="fas fa-envelope"></i>
                        </span>
                    </div>

                    <!-- Mensaje de error -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert-premium py-2 mb-3">
                            <i class="fas fa-info-circle"></i> @ViewBag.Error
                        </div>
                    }

                    <!-- Mensaje de éxito -->
                    @if (ViewBag.Success != null)
                    {
                        <div class="success-message-premium py-2 mb-3">
                            <i class="fas fa-check-circle"></i> @ViewBag.Success
                        </div>
                    }

                    <!-- Botón de envío -->
                    <button class="btn btn-send-premium" type="submit" id="submitBtn">
                        <i class="fas fa-paper-plane"></i> ENVIAR INSTRUCCIONES
                    </button>

                    <!-- Enlace de regreso -->
                    <div class="text-center">
                        <a href="@Url.Action("Index","Acceso")" class="back-link-premium">
                            <i class="fas fa-arrow-left"></i> VOLVER AL SALÓN PRIVADO
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Spinner de carga -->
    <div class="loading-spinner" id="loadingSpinner">
        <div class="spinner-content">
            <i class="fas fa-key"></i>
            <p>ENVIANDO INSTRUCCIONES...</p>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>

    <script>
        $(document).ready(function () {
            // Crear partículas de fondo
            createParticles();

            // Configurar overlay de carga personalizado
            $.LoadingOverlaySetup({
                background: "rgba(248, 245, 240, 0.95)",
                custom: $("<div>", {
                    style: "text-align: center;"
                }).append(
                    $("<div>", {
                        style: "position: relative; margin-bottom: 20px;"
                    }).append(
                        $("<i>", {
                            class: "fas fa-key",
                            style: "color: var(--fancy-pink); font-size: 60px; display: block; animation: keyFloat 2s infinite ease-in-out;"
                        }),
                        $("<div>", {
                            style: "position: absolute; width: 100px; height: 100px; border-radius: 50%; background: radial-gradient(circle, var(--pink-glow) 0%, transparent 70%); top: 50%; left: 50%; transform: translate(-50%, -50%); animation: pulse 2s infinite ease-in-out;"
                        })
                    ),
                    $("<p>", {
                        text: "ENVIANDO INSTRUCCIONES...",
                        style: "color: var(--texto-suave); font-family: 'Montserrat', sans-serif; font-weight: 300; letter-spacing: 2px; margin-top: 20px; font-size: 0.9rem;"
                    })
                ),
                text: "",
                textColor: "var(--texto-suave)"
            });

            // Manejar envío del formulario
            $("#recoveryForm").submit(function (e) {
                const email = $("#emailInput").val();
                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

                if (!emailRegex.test(email)) {
                    e.preventDefault();
                    $("#emailInput").addClass("invalid").removeClass("valid");
                    showError("Por favor, ingresa un correo electrónico válido.");
                    return false;
                }

                $.LoadingOverlay("show");
                return true;
            });

            // Validación en tiempo real del correo
            $("#emailInput").on('input', function () {
                const email = $(this).val();
                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

                if (email) {
                    if (emailRegex.test(email)) {
                        $(this).removeClass('invalid').addClass('valid');
                        $(this).next('.input-icon-premium').css('color', 'var(--esmeralda-lumi)');
                    } else {
                        $(this).removeClass('valid').addClass('invalid');
                        $(this).next('.input-icon-premium').css('color', 'var(--coral-soft)');
                    }
                } else {
                    $(this).removeClass('valid invalid');
                    $(this).next('.input-icon-premium').css('color', 'var(--fancy-pink)');
                }
            });

            // Efecto de enfoque en el campo
            $(".form-control-premium").focus(function () {
                $(this).closest(".form-group-premium").addClass("focused");
            }).blur(function () {
                if ($(this).val() === "") {
                    $(this).closest(".form-group-premium").removeClass("focused");
                }
            });

            // Función para mostrar error
            function showError(message) {
                // Remover mensajes existentes
                $(".alert-premium, .success-message-premium").remove();

                // Crear nuevo mensaje de error
                const errorDiv = $(`
                        <div class="alert-premium py-2 mb-3">
                            <i class="fas fa-exclamation-circle"></i> ${message}
                        </div>
                    `);

                // Insertar después del campo de email
                $(".form-group-premium").after(errorDiv);

                // Animar entrada
                errorDiv.css({
                    'opacity': '0',
                    'transform': 'translateY(-10px)'
                });

                setTimeout(() => {
                    errorDiv.css({
                        'opacity': '1',
                        'transform': 'translateY(0)',
                        'transition': 'all 0.3s ease'
                    });
                }, 10);
            }

            // Función para crear partículas
            function createParticles() {
                const container = $('#recoveryParticles');
                const particleCount = 12;

                for (let i = 0; i < particleCount; i++) {
                    const size = Math.random() * 3 + 1;
                    const posX = Math.random() * 100;
                    const posY = Math.random() * 100;
                    const delay = Math.random() * 20;
                    const duration = Math.random() * 20 + 10;
                    const opacity = Math.random() * 0.1 + 0.05;

                    const particle = $('<div class="recovery-particle"></div>').css({
                        width: size + 'px',
                        height: size + 'px',
                        left: posX + 'vw',
                        top: posY + 'vh',
                        background: `rgba(${Math.random() * 50 + 180}, ${Math.random() * 50 + 100}, ${Math.random() * 50 + 200}, ${opacity})`,
                        animationDelay: delay + 's',
                        animationDuration: duration + 's'
                    });

                    container.append(particle);
                }
            }

            // Animación de entrada para el contenido
            setTimeout(() => {
                $('.form-group-premium').css({
                    'opacity': '0',
                    'transform': 'translateY(20px)'
                });

                setTimeout(() => {
                    $('.form-group-premium').css({
                        'opacity': '1',
                        'transform': 'translateY(0)',
                        'transition': 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)'
                    });
                }, 300);
            }, 300);

            // Si hay un mensaje de éxito, ocultar automáticamente después de 5 segundos
            @if (ViewBag.Success != null)
            {
                <text>
                setTimeout(() => {
                    $('.success-message-premium').fadeOut(500, function() {
                        $(this).remove();
                    });
                }, 5000);
                </text>
            }

            // Si hay un mensaje de error, ocultar al hacer clic
            $('body').on('click', '.alert-premium', function() {
                $(this).fadeOut(300, function() {
                    $(this).remove();
                });
            });
        });
    </script>
</body>
</html>